# Database (provided automatically by Railway PostgreSQL plugin)
DATABASE_URL=postgresql://user:password@host:5432/norahairline

# Server
NODE_ENV=production
PORT=5000

# JWT (generate a strong random secret — 64+ characters):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server logs a warning at startup if this looks weak or like a placeholder.
JWT_SECRET=your-strong-jwt-secret-here

# Frontend URL (leave empty — backend serves the frontend)
# FRONTEND_URL=https://your-app.railway.app

# Cloudflare R2 (new uploads — products, gallery, flash sale banner)
# Cloudflare dashboard → R2 → Manage API Tokens
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name
R2_PUBLIC_URL=https://your-public-bucket-domain

# Cloudinary (legacy — kept only to delete assets from products/gallery/banner
# uploads made before the R2 migration; not used for new uploads)
# Sign up free at https://cloudinary.com, then go to Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# OneSignal push notifications (OneSignal dashboard → Settings → Keys & IDs)
ONESIGNAL_APP_ID=your-onesignal-app-id-here
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key-here
